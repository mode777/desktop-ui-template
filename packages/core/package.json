{
  "name": "@workbench-kit/core",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Headless layout, tab, resize and persistence helpers for the workbench kit.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
