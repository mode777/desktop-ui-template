{
  "name": "@workbench-kit/elements",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Per-tag vscode-elements registration entries and JSX typings for the workbench kit.",
  "license": "MIT",
  "sideEffects": [
    "./src/*.ts",
    "./dist/*.js"
  ],
  "files": [
    "dist",
    "src/global.d.ts"
  ],
  "main": "./dist/all.js",
  "types": "./src/global.d.ts",
  "exports": {
    ".": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js",
      "default": "./dist/all.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "import": "./dist/all.js",
      "default": "./dist/all.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js",
      "default": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "import": "./dist/collapsible.js",
      "default": "./dist/collapsible.js"
    },
    "./context-menu": {
      "types": "./dist/context-menu.d.ts",
      "import": "./dist/context-menu.js",
      "default": "./dist/context-menu.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js",
      "default": "./dist/icon.js"
    },
    "./tab-header": {
      "types": "./dist/tab-header.d.ts",
      "import": "./dist/tab-header.js",
      "default": "./dist/tab-header.js"
    },
    "./tab-panel": {
      "types": "./dist/tab-panel.d.ts",
      "import": "./dist/tab-panel.js",
      "default": "./dist/tab-panel.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "import": "./dist/textarea.js",
      "default": "./dist/textarea.js"
    },
    "./textfield": {
      "types": "./dist/textfield.d.ts",
      "import": "./dist/textfield.js",
      "default": "./dist/textfield.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js",
      "default": "./dist/tree.js"
    },
    "./types": {
      "types": "./src/global.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@vscode-elements/elements": ">=2.5.1 <3",
    "react": ">=19"
  }
}
