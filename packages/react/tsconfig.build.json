{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {},
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmitOnError": true
  },
  "include": ["src", "../../packages/elements/src/global.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
