{
  "name": "@workbench-kit/react",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Controlled React primitives for composing a workbench.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workbench-kit/core": "*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
